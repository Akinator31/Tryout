# Tryout control plane. Copy to .env next to compose.yaml and fill in. Guide: docs/deployment.md.

# Image version: a release (0.1.0), or edge until the first release. In production, pin
# the digest too: TRYOUT_VERSION=0.1.0@sha256:...
TRYOUT_VERSION=edge
# A fork publishes to its own namespace.
#TRYOUT_CONTROL_PLANE_IMAGE=ghcr.io/<owner>/tryout-control-plane
# Pin PostgreSQL by digest as well (14 or later).
#POSTGRES_IMAGE=postgres:17-alpine@sha256:...

# URL-safe database password: openssl rand -hex 32
POSTGRES_PASSWORD=

# Where the control plane is published for your reverse proxy or tunnel.
CONTROL_PLANE_PUBLISH=127.0.0.1:3000
