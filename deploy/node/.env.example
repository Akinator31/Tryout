# Tryout node. Copy to .env next to compose.yaml and fill in. Guide: docs/deployment.md.

# Image version: a release (0.1.0), or edge until the first release. In production, pin
# the digest too: TRYOUT_VERSION=0.1.0@sha256:...
TRYOUT_VERSION=edge
# A fork publishes to its own namespace.
#TRYOUT_NODE_IMAGE=ghcr.io/<owner>/tryout-node

# strict: a machine or VM dedicated to sessions, with gVisor (runsc). This example is
# written for strict; single-host (rootless daemon) has its own guide on the roadmap.
NODE_PROFILE=strict
# Weaker opt-out that accepts runc and every other runtime. Read SECURITY.md first.
#ALLOW_RUNC=false
#DEFAULT_RUNTIME=runsc

# The Docker daemon that runs sessions, and the group that owns its socket
# (stat -c %g <socket>).
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GID=

# Shared secret between the agent and the gateway: openssl rand -hex 32
GATEWAY_TOKEN=

# Where the agent's private API (mutual TLS) is published on this machine: a private or VPN
# address, or the loopback when a tunnel carries it. Never a public address.
AGENT_PUBLISH=10.0.50.10:7000

# Where the gateway is published for your reverse proxy or tunnel (sessions, /s/<id>/).
GATEWAY_PUBLISH=127.0.0.1:8080
# The control plane's public origin: the session iframe is nested in its embed page.
FRAME_ANCESTORS=https://tryout.example.org

# Optional: registry credentials for private project images, in registry/auth.json.
#REGISTRY_AUTH_FILE=/etc/tryout/registry/auth.json

# Node-side caps.
#MAX_SESSIONS=10
#SESSION_MAX_AGE_CAP=2h
