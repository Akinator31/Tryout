{
  "listen_port": 3000,
  "embed_frame_ancestors": "'self' http://localhost:3000",
  "nodes": {
    "local": {
      "agent_url": "http://agent:7000",
      "agent_token": "change-me-agent-token",
      "public_url": "http://localhost:8080/s/{session}/",
      "probe_url": "http://tryout-gateway:8080/s/{session}/",
      "max_sessions": 6
    }
  },
  "projects": {
    "cli-hello": {
      "node": "local",
      "image": "tryout-example/cli-hello:dev",
      "kind": "terminal",
      "port": 7681,
      "max_sessions": 2,
      "max_age_s": 600
    },
    "webtop": {
      "node": "local",
      "image": "lscr.io/linuxserver/webtop:latest",
      "kind": "desktop",
      "port": 3000,
      "max_sessions": 1,
      "max_age_s": 900
    }
  }
}
